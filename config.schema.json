{
  "pluginAlias": "OpenMeteoClimate",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Free, open-source weather estimates from Open-Meteo (no API key for eligible non-commercial use). Enter your own location. Model estimates are not safety-critical weather warnings. The fan-style tiles are experimental display workarounds, not controllable fans.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Location name",
        "default": "My Location"
      },
      "latitude": {
        "type": "number",
        "title": "Latitude",
        "minimum": -90,
        "maximum": 90,
        "required": true
      },
      "longitude": {
        "type": "number",
        "title": "Longitude",
        "minimum": -180,
        "maximum": 180,
        "required": true
      },
      "refreshMinutes": {
        "type": "integer",
        "title": "Refresh interval (minutes)",
        "minimum": 15,
        "maximum": 180,
        "default": 30
      },
      "windThresholdKmh": {
        "type": "number",
        "title": "Strong wind threshold (km/h)",
        "minimum": 5,
        "maximum": 200,
        "default": 40
      },
      "frostThresholdC": {
        "type": "number",
        "title": "Frost risk threshold (°C)",
        "minimum": -10,
        "maximum": 10,
        "default": 2
      },
      "forecastHours": {
        "type": "integer",
        "title": "Weather warning forecast window (hours)",
        "minimum": 1,
        "maximum": 12,
        "default": 3
      },
      "showWind": {
        "type": "boolean",
        "title": "Strong wind virtual sensor",
        "default": true
      },
      "showSnow": {
        "type": "boolean",
        "title": "Snow forecast virtual sensor",
        "default": true
      },
      "showFrost": {
        "type": "boolean",
        "title": "Frost risk virtual sensor",
        "default": true
      },
      "showConditionTiles": {
        "type": "boolean",
        "title": "Show wind, snow and frost as separate Apple Home switch tiles (read-only forecast status)",
        "default": true
      },
      "showExperimentalWindFan": {
        "type": "boolean",
        "title": "Experimental wind-speed fan tile (1% = 1 mph; max 100 mph)",
        "default": true
      },
      "showExperimentalWeatherFans": {
        "type": "boolean",
        "title": "Experimental rain, snow and ice-risk percentage fan tiles for Climate (see README for units)",
        "default": true
      }
    }
  }
}
